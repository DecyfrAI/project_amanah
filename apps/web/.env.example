# Project Amanah, web frontend environment.
#
# EVERY value here is bundled into browser JavaScript and MUST be treated as
# public. Never place the Supabase service-role key, database URL, YouTube key,
# Gemini key, or any job-trigger secret in this file or in Netlify's VITE_*
# variables. See docs/planning/PROJECT_AMANAH_IMPLEMENTATION_DEPLOYMENT.md §5.

# Which data source the application reads from.
#   fixture:  all data comes from committed synthetic/redacted JSON
#   live:     authenticated requests go to the FastAPI service
#   fallback: try FastAPI first, then show a visible "Fixture data" banner
VITE_DATA_MODE=fixture

# Base URL of the FastAPI service. Unused when VITE_DATA_MODE=fixture.
VITE_API_BASE_URL=http://localhost:8000

# Supabase project URL and anon key. The anon key is public by design and is
# safe to expose; it is constrained by row-level security on the server.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
