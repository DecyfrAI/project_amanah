# Project Amanah backend configuration template.
# Copy to backend/.env and fill in real values. Never commit a populated file.
# Load it with: uv run --project backend --env-file backend/.env <command>
#
# Any optional value left as <REDACTED> (or blank) is treated as unset, so an
# unfilled connector stays disabled instead of being called with a placeholder
# key. Required variables have no such fallback: a placeholder left in one of
# them fails startup.

# --- Required: the service refuses to start without these -------------------

# Comma-separated browser origins allowed to call this API (scheme + host + port,
# no trailing path).
APP_ORIGIN=http://localhost:5173

# Supabase project base URL. Must be https. The expected access-token issuer is
# derived from it as <SUPABASE_URL>/auth/v1.
SUPABASE_URL=https://your-project.supabase.co

# Supabase JWT secret used to verify access tokens server-side. At least 32
# characters. Supabase project settings -> API -> JWT Settings.
SUPABASE_JWT_SECRET=<REDACTED>

# --- Optional: readiness ----------------------------------------------------

# Postgres connection string. The process starts without it, but /readyz reports
# `degraded` until it is set, and every /v1 product read answers 503.
DATABASE_URL=postgresql://postgres:<REDACTED>@localhost:5432/postgres

# Explicit bounds on both halves of a database call: opening a connection, and a
# query that has already started. Neither may fall back to a driver default of
# "forever".
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_POOL_SIZE=5

# Instance-level per-IP ceiling. Durable per-user mutation limits are separate.
API_RATE_LIMIT_REQUESTS=300
API_RATE_LIMIT_WINDOW_SECONDS=60

# --- Optional: behaviour ----------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO
# fixture | live | fallback
DATA_MODE=fixture

# --- Optional: private object storage ---------------------------------------

# Server-only Supabase service-role key, used to read private objects and to ask
# Supabase to sign short-lived object URLs. This is NOT the same value as
# SUPABASE_JWT_SECRET: that one verifies inbound access tokens and is a signing
# secret, not an access token. Without this key the image catalogue reports
# itself unavailable rather than serving links that would fail.
# Never expose this to a browser or put it in a VITE_ variable.
SUPABASE_STORAGE_SECRET_KEY=

# Private bucket holding the reviewed research image corpus.
SUPABASE_STORAGE_BUCKET=research-images

# Seconds a signed object URL stays valid (30-3600).
STORAGE_SIGNED_URL_TTL_SECONDS=300

# --- Optional: connectors ---------------------------------------------------
# A missing value disables only that connector. Do not set a value for a
# connector whose access has not been approved.

# Gemini requires both values before it is considered configured. Unconfigured is
# a supported state: classification defers, deterministic metrics still compute,
# and the rest of the product keeps working.
GEMINI_API_KEY=<REDACTED>
GEMINI_MODEL=gemini-2.5-flash

# Bounds every model call shares. None of them can be disabled; the defaults are
# shown so an operator can see what is in force without reading the code.
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=2
GEMINI_MAX_INPUT_CHARACTERS=8000
GEMINI_MAX_OUTPUT_TOKENS=1024

# Spend ceilings. Exhausting either defers the remaining items and leaves the
# rest of the site operational (spec.md section 11.2).
GEMINI_PER_RUN_TOKEN_BUDGET=200000
GEMINI_DAILY_TOKEN_BUDGET=2000000

YOUTUBE_API_KEY=<REDACTED>
NEWS_API_KEY=<REDACTED>

# Reddit stays disabled until official research access is approved.
REDDIT_CLIENT_ID=<REDACTED>
REDDIT_CLIENT_SECRET=<REDACTED>

# --- Reserved for later milestones ------------------------------------------
# Listed for planning only. The service does not read these yet; each is
# introduced by the step named beside it.
#
# SUPABASE_STORAGE_SECRET_KEY   B-S7  privileged background writes
# ETL_CONFIG_PATH             B-S8  approved source-seed configuration
# DATASET_MANIFEST_PATH       B-S9A reviewed datapack manifests
# ETL_MAX_ITEMS               B-S21 per-run item cap
# ETL_TOKEN_BUDGET            B-S13 Gemini token budget
# CONFIDENCE_THRESHOLDS_VERSION B-S14 confidence tier thresholds
# TAXONOMY_VERSION            B-S14 active taxonomy version
# ALLOW_THIRD_PARTY_CONTENT_INFERENCE B-S13 third-party transfer gate

# --- Collection pipeline (Milestone 3) -------------------------------------

# Reviewed source and seed catalogue. Defaults to `config/` in the repository,
# which is committed and contains no secrets. Set this only when a deployment
# ships the package without the repository alongside it.
# SOURCE_CONFIG_DIRECTORY=/etc/amanah/config

# Encrypts permitted original text at rest: base64 of exactly 32 bytes.
# Generate one with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Leave it unset and the original text is NOT retained at all. It is never
# written as plaintext into a column the schema calls ciphertext.
CONTENT_ENCRYPTION_KEY=<REDACTED>

# Bounds every outbound provider call and every user-URL retrieval. None of
# these may be disabled: there is no "no timeout" and no "read it all" value.
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=10
HTTP_TOTAL_TIMEOUT_SECONDS=20
HTTP_MAX_RESPONSE_BYTES=2000000
HTTP_MAX_REDIRECTS=3
