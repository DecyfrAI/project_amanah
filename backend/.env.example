# Project Amanah backend configuration template.
# Copy to backend/.env and fill in real values. Never commit a populated file.
# Load it with: uv run --project backend --env-file backend/.env <command>
#
# Any optional value left as <REDACTED> (or blank) is treated as unset, so an
# unfilled connector stays disabled instead of being called with a placeholder
# key. Required variables have no such fallback: a placeholder left in one of
# them fails startup.

# --- Required: the service refuses to start without these -------------------

# Comma-separated browser origins allowed to call this API (scheme + host + port,
# no trailing path).
APP_ORIGIN=http://localhost:5173

# Supabase project base URL. Must be https. The expected access-token issuer is
# derived from it as <SUPABASE_URL>/auth/v1.
SUPABASE_URL=https://your-project.supabase.co

# Supabase JWT secret used to verify access tokens server-side. At least 32
# characters. Supabase project settings -> API -> JWT Settings.
SUPABASE_JWT_SECRET=<REDACTED>

# --- Optional: readiness ----------------------------------------------------

# Postgres connection string. The process starts without it, but /readyz reports
# `degraded` until it is set, and every /v1 product read answers 503.
DATABASE_URL=postgresql://postgres:<REDACTED>@localhost:5432/postgres

# Explicit bounds on both halves of a database call: opening a connection, and a
# query that has already started. Neither may fall back to a driver default of
# "forever".
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_POOL_SIZE=5

# --- Optional: behaviour ----------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO
# fixture | live | fallback
DATA_MODE=fixture

# --- Optional: connectors ---------------------------------------------------
# A missing value disables only that connector. Do not set a value for a
# connector whose access has not been approved.

# Gemini requires both values before it is considered configured.
GEMINI_API_KEY=<REDACTED>
GEMINI_MODEL=gemini-2.5-flash

YOUTUBE_API_KEY=<REDACTED>
NEWS_API_KEY=<REDACTED>

# Reddit stays disabled until official research access is approved.
REDDIT_CLIENT_ID=<REDACTED>
REDDIT_CLIENT_SECRET=<REDACTED>

# --- Reserved for later milestones ------------------------------------------
# Listed for planning only. The service does not read these yet; each is
# introduced by the step named beside it.
#
# SUPABASE_SERVICE_ROLE_KEY   B-S7  privileged background writes
# ETL_CONFIG_PATH             B-S8  approved source-seed configuration
# DATASET_MANIFEST_PATH       B-S9A reviewed datapack manifests
# ETL_MAX_ITEMS               B-S21 per-run item cap
# ETL_TOKEN_BUDGET            B-S13 Gemini token budget
# CONFIDENCE_THRESHOLDS_VERSION B-S14 confidence tier thresholds
# TAXONOMY_VERSION            B-S14 active taxonomy version
# ALLOW_THIRD_PARTY_CONTENT_INFERENCE B-S13 third-party transfer gate
